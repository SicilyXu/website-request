# SMTP Configuration
# For Gmail: use App Password (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-app-password

# Or for other providers like SendGrid, Mailgun, etc.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Recipient emails (already configured in server.js)
# MANAGER_EMAIL=sicily@johnbatman.com.au
# STAFF_EMAIL=JenniferReed@johnbatman.com.au

PORT=3000
